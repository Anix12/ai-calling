# Copy to .env.production.local (or set in your host's dashboard) before building for production.
# Leave a value empty if the destination doesn't exist yet: the page then shows it as "coming soon"
# text instead of a dead link (and hides "Log in").

# Production domain for this page, e.g. https://ai-calling.yourdomain.com — enables canonical URL,
# sitemap and share-image tags. localhost or malformed values are ignored.
NEXT_PUBLIC_SITE_URL=

# Primary CTAs. Without these, "Experience AI Calling" scrolls to "How it works" and
# "Book a Demo" scrolls to the closing CTA section.
NEXT_PUBLIC_SIGNUP_URL=
NEXT_PUBLIC_DEMO_URL=
NEXT_PUBLIC_LOGIN_URL=

# Main LeadsZone website (footer link)
NEXT_PUBLIC_MAIN_SITE_URL=
NEXT_PUBLIC_CONTACT_URL=

# Legal pages (required before launch)
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_COOKIES_URL=
